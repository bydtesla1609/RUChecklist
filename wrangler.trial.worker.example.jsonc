{
  "name": "ruchecklist-trial-sync",
  "main": "trial-worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruchecklist-trial",
      "database_id": "REPLACE_WITH_TRIAL_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
