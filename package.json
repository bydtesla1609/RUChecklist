{
  "name": "ruchecklist",
  "version": "2.13.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node local.mjs",
    "build:pages": "node build-pages.mjs",
    "build:extension": "python package-extension.py",
    "test": "node --test test.mjs resources-test.mjs completion-test.mjs cloud-test.mjs academic-test.mjs trial-test.mjs zhifz-test.mjs ruc-lists-test.mjs generic-test.mjs",
    "check": "node --check worker.mjs && node --check static/app.js",
    "test:ui": "node ui-test.mjs",
    "test:trial-ui": "node trial-ui-test.mjs",
    "test:extension": "node extension-ui-test.mjs",
    "test:cloud-html": "node cloud-html-test.mjs",
    "build:trial": "node build-pages.mjs --trial",
    "test:generic-ui": "node generic-ui-test.mjs",
    "test:generic-native": "node generic-native-test.mjs"
  }
}
