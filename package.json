{
  "name": "ruchecklist",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node local.mjs",
    "build:pages": "node build-pages.mjs",
    "build:extension": "python package-extension.py",
    "test": "node --test test.mjs resources-test.mjs completion-test.mjs cloud-test.mjs",
    "check": "node --check worker.mjs && node --check static/app.js",
    "test:ui": "node ui-test.mjs",
    "test:extension": "node extension-ui-test.mjs",
    "test:cloud-html": "node cloud-html-test.mjs"
  }
}
