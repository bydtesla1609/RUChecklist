{
  "name": "rucapture",
  "pages_build_output_dir": "./dist/public",
  "compatibility_date": "2026-05-15",
  "vars": {
    "REGISTRATION_OPEN": "true",
    "PUBLIC_REGISTRATION": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruchecklist-trial",
      "database_id": "FILL_DATABASE_ID"
    },
    {
      "binding": "STORE_A",
      "database_name": "rucapture-store-a",
      "database_id": "FILL_DATABASE_ID"
    },
    {
      "binding": "STORE_B",
      "database_name": "rucapture-store-b",
      "database_id": "FILL_DATABASE_ID"
    },
    {
      "binding": "STORE_C",
      "database_name": "rucapture-store-c",
      "database_id": "FILL_DATABASE_ID"
    }
  ]
}
